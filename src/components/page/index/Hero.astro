          <path class="draw-path" d="M259.041 12.9279C259.276 11.8157 260.175 10.8118 261.289 11.0649C262.442 11.3267 262.762 12.7362 262.413 13.8594C262.107 14.8475 261.381 15.6911 260.353 15.5361C259.22 15.3654 258.806 14.0424 259.041 12.9279Z" stroke="black"/>
        </svg>
        <span class="hand absolute -bottom-8 animate-wave origin-bottom-right -z-1">👋</span>
      </div>
    </h1>
    <p class="hero-subtitle font-mono text-[clamp(1rem,3vw,1.25rem)] text-muted-foreground tracking-[0.2em] uppercase font-medium mt-4 lg:mt-6">
      不定期で主にフロントエンド関連についての記事を投稿します。
    </p>
    <div class="flex items-center justify-center gap-4 mt-12 hero-cta">
      <Button href="/article" size="lg" class="rounded-full">
        記事を読む
        <ArrowRight class="w-4 h-4" />
      </Button>
      <Button href="/#about" variant="outline" size="lg" class="rounded-full">
        私について
      </Button>
    </div>
    <div class="mt-12 absolute bottom-12 left-1/2 -translate-x-1/2 hero-cta"><ArrowDown class="w-4 h-4 animate-bounce" /></div>
  </div>
</section>

<style>
  .greeting {
    visibility: hidden;
    transform: translateY(20px);
    animation: fadeInUp 0.8s cubic-bezier(0.23, 1, 0.32, 1) forwards;
  }

  .draw-path {
    stroke: var(--foreground);
    stroke-width: 1.5;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    visibility: hidden;
  }

  .hero-subtitle {
    visibility: hidden;
    animation: fadeIn 1.2s ease-out 3s forwards;
  }

  .hero-cta {
    visibility: hidden;
    animation: fadeIn 1.2s ease-out 3.5s forwards;
  }

  .hand {
    font-size: 1em;
    visibility: hidden;
    animation: fadeIn 0.5s ease-out 3s forwards, wave 2s ease-in-out 3.5s;
    right: -0.4em;
  }

  @keyframes wave {
    0% { transform: rotate(0deg); }
    10% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    30% { transform: rotate(14deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
    60% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }

  @keyframes fadeInUp {
    0% {
      opacity: 0;
      visibility: visible;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    0% {
      opacity: 0;
      visibility: visible;
    }
    100% {
      opacity: 1;
      visibility: visible;
    }
  }
</style>

<script>
  import { gsap } from "gsap";

  const initSignatureAnimation = () => {
    const svg = document.querySelector(".signature-svg");
    const originalPaths = document.querySelectorAll(".draw-path");
    
    if (!svg || originalPaths.length === 0) return;

    const tl = gsap.timeline({ delay: 0.8 });
    const allSegments: SVGPathElement[] = [];

    // 1. パスを「M」単位で細かく分解してシーケンシャルな描画を可能にする
    originalPaths.forEach((path) => {
      const d = path.getAttribute("d");
      if (!d) return;

      const segments = d.split(/(?=M)/);
      
      segments.forEach((seg) => {
        if (seg.trim().length < 5) return;
        
        const newPath = document.createElementNS("http://www.w3.org/2000/svg", "path");
        newPath.setAttribute("d", seg);
        newPath.classList.add("draw-path");
        // CSSのスタイルを継承
        newPath.style.stroke = "var(--foreground)";
        newPath.style.strokeWidth = "4";
        newPath.style.fill = "none";
        newPath.style.strokeLinecap = "round";
        newPath.style.strokeLinejoin = "round";
        
        svg.appendChild(newPath);
        allSegments.push(newPath);
      });
      
      path.remove();
    });

    // 2. 初期化（描画準備）
    allSegments.forEach((path) => {
      const length = path.getTotalLength();
      path.style.visibility = "visible";
      path.style.strokeDasharray = length.toString();
      path.style.strokeDashoffset = length.toString();
    });

    // 3. アニメーション実行
    allSegments.forEach((path) => {
      const length = path.getTotalLength();
      let duration = length / 600; 
      if (duration < 0.1) duration = 0.1;

      tl.to(path, {
        strokeDashoffset: 0,
        duration: duration,
        ease: "none"
      }, "-=0.01");
    });
  };

  // View Transitions 対応: ページロードごとに初期化
  document.addEventListener("astro:page-load", initSignatureAnimation);
</script>
