---
import { ArrowDown, ArrowRight } from "@lucide/astro";
import Button from "@/components/starwind/button/Button.astro";
---

<section class="min-h-[450px] max-h-[900px] h-[calc(100vh-60px)] relative flex items-center justify-center p-8 overflow-hidden bg-[radial-gradient(circle_at_top_right,rgba(120,119,198,0.1),transparent),radial-gradient(circle_at_bottom_left,rgba(120,119,198,0.05),transparent)]">
  <div class="text-center max-w-(--size-3xl) w-full">
    <h1 class="text-[clamp(2.5rem,8vw,5rem)] font-extrabold leading-[1.1] flex flex-wrap items-center justify-center gap-[0.2em] mb-8 text-foreground font-sans">
