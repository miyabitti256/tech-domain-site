---
import type { MarkdownHeading } from "astro";

export interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// Limit depth to h2 and h3
const filteredHeadings = headings.filter(
	(heading) => heading.depth > 1 && heading.depth <= 3,
);
---

<details
  class="toc border-border/60 bg-muted/20 group mt-8 mb-12 rounded-lg border"
>
  <summary
    class="text-foreground flex cursor-pointer list-none items-center justify-between px-5 py-4 text-sm font-bold [&::-webkit-details-marker]:hidden"
  >
    目次
    <span
      class="text-muted-foreground transition-transform group-open:rotate-180"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg
      >
    </span>
  </summary>
  <div class="border-border/50 border-t p-5 px-5">
    <ul class="space-y-3">
      {
        filteredHeadings.map((heading) => (
          <li
            class="line-clamp-1"
            style={`margin-left: ${(heading.depth - 2) * 1.25}rem;`}
          >
            <a
              href={`#${heading.slug}`}
              class="text-muted-foreground hover:text-primary hover:border-primary block border-l-2 border-transparent py-0.5 pl-2 text-sm transition-colors"
            >
              {heading.text.replace(/^#\s*/, "")}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</details>

<style>
  .toc {
    transition: box-shadow 0.2s ease;
  }

  .toc:hover {
    box-shadow: 0 4px 12px -2px rgba(0, 0, 0, 0.05);
  }

  .toc::details-content {
    opacity: 0;
    block-size: 0;
    overflow: clip;
    transition:
      block-size 400ms cubic-bezier(0.4, 0, 0.2, 1),
      opacity 400ms cubic-bezier(0.4, 0, 0.2, 1),
      content-visibility 400ms allow-discrete;
  }

  .toc[open]::details-content {
    opacity: 1;
    block-size: auto;
  }

  /* 2026年標準: Safari等へのプログレッシブ・エンハンスメント */
  @supports not (interpolate-size: allow-keywords) {
    .toc::details-content {
      transition: opacity 0.3s ease;
    }
    .toc[open]::details-content {
      block-size: auto;
    }
  }
</style>
