---
import { BookOpen, Check, RefreshCcw, Sparkles } from "@lucide/astro";
import AuthorCard from "@/components/layouts/AuthorCard.astro";
import Badge from "@/components/starwind/badge/Badge.astro";
import {
	Breadcrumb,
	BreadcrumbItem,
	BreadcrumbLink,
	BreadcrumbList,
	BreadcrumbPage,
	BreadcrumbSeparator,
} from "@/components/starwind/breadcrumb";
import type { BookMeta } from "@/contents/book/types";

export type PageType = "info" | "toc" | "chapters";

interface Props {
	type: PageType;
	meta?: BookMeta;
	slug?: string;
	totalChapters?: number;
	formattedDate?: string;
	formattedUpdateDate?: string | null;
	publishedAt?: Date;
	updatedAt?: Date | null;
	chapters?: { slug: string; title: string; index: number }[];
	hasAuthorCard?: boolean;
	isMobile?: boolean;
}

const {
	type,
	meta,
	slug,
	totalChapters = 0,
	formattedDate,
	formattedUpdateDate,
	publishedAt,
	updatedAt,
	chapters = [],
	hasAuthorCard = false,
	isMobile = false,
} = Astro.props;

const progressTextClass = isMobile
	? "js-mobile-progress-text"
	: "js-desktop-progress-text";
const progressBarClass = isMobile
	? "js-mobile-progress-bar"
	: "js-desktop-progress-bar";
---

<div class="p-6 md:p-10 flex flex-col h-full justify-between overflow-y-auto hide-scrollbar">
  {type === "info" && meta && slug && (
    <>
      <div>
        <div class="mb-4">
          <Breadcrumb>
            <BreadcrumbList>
              <BreadcrumbItem><BreadcrumbLink href="/">Home</BreadcrumbLink></BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem><BreadcrumbLink href="/book">Book</BreadcrumbLink></BreadcrumbItem>
              <BreadcrumbSeparator />
              <BreadcrumbItem><BreadcrumbPage class="line-clamp-1">{meta.title}</BreadcrumbPage></BreadcrumbItem>
            </BreadcrumbList>
          </Breadcrumb>
        </div>
        <h1 class={`${isMobile ? 'text-2xl' : 'text-3xl'} font-bold tracking-tight text-foreground mb-4 leading-snug`}>{meta.title}</h1>
        
        {publishedAt && formattedDate && (
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mb-4 text-xs text-muted-foreground">
            <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
            {updatedAt && formattedUpdateDate && (
              <div class="flex items-center gap-1 list-none">
                <RefreshCcw class="w-3.5 h-3.5" />
                <time datetime={updatedAt.toISOString()}>{formattedUpdateDate}</time>
              </div>
            )}
            {meta.tags && meta.tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {meta.tags.map((tag) => (
                  <Badge href={`/search?tag=${encodeURIComponent(tag)}`} variant="outline" class="text-[10px] px-1.5 py-0">#{tag}</Badge>
                ))}
              </div>
            )}
          </div>
        )}
        
        <div class={`${isMobile ? 'text-xs' : 'text-sm'} text-muted-foreground leading-relaxed mb-4 font-medium line-clamp-3`}>
          {meta.description}
        </div>
        
        <div class="prose prose-xs dark:prose-invert max-w-none text-muted-foreground">
          <Fragment set:html={meta.summary
            .split('\n')
            .map(line => {
              if (line.startsWith('### ')) return `<h3 class="${isMobile ? 'text-xs mt-2 mb-1' : 'text-sm mt-2 mb-1'} font-bold">${line.slice(4)}</h3>`;
              if (line.startsWith('## ')) return `<h2 class="${isMobile ? 'text-sm mt-2.5 mb-1' : 'text-base mt-3 mb-1.5'} font-bold">${line.slice(3)}</h2>`;
              if (line.startsWith('- ')) return `<li class="${isMobile ? 'text-[11px]' : 'text-xs'}">${line.slice(2).replace(/\*\*(.+?)\*\*/g, '<strong class="text-foreground">$1</strong>')}</li>`;
              if (line.trim() === '') return '';
              return `<p class="${isMobile ? 'text-[11px] my-1' : 'text-xs my-1'}">${line.replace(/\*\*(.+?)\*\*/g, '<strong class="text-foreground">$1</strong>').replace(/`(.+?)`/g, '<code class="text-foreground">$1</code>')}</p>`;
            })
            .join('\n')
          } />
        </div>
      </div>
      
      <div class={`${isMobile ? 'pt-3' : 'pt-4'} mt-auto border-t border-border/50`}>
        <div class="flex items-center justify-between text-xs mb-1.5">
          <span class="font-medium text-muted-foreground flex items-center gap-1">
            <Sparkles class="w-3.5 h-3.5 text-primary" /> 読了ステータス
          </span>
          <span class={`${progressTextClass} font-mono font-bold text-primary text-xs`}>0 / {totalChapters} (0%)</span>
        </div>
        <div class="w-full h-2 bg-muted rounded-full overflow-hidden">
          <div class={`${progressBarClass} h-full bg-primary transition-all duration-500 w-0`}></div>
        </div>
      </div>
    </>
  )}

  {(type === "toc" || type === "chapters") && slug && (
    <>
      <div>
        {type === "toc" && meta && (
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-border/50 shrink-0">
            <h2 class={`${isMobile ? 'text-lg' : 'text-xl'} font-bold flex items-center gap-2 text-foreground`}>
              <BookOpen class="w-5 h-5 text-muted-foreground" /> 目次
            </h2>
            <span class="text-xs text-muted-foreground bg-muted px-2.5 py-0.5 rounded-full font-medium border border-border/50">{meta.chapters.length} 章</span>
          </div>
        )}
        
        {chapters.length > 0 && (
          <ol class="space-y-2">
            {chapters.map((ch) => (
              <li data-chapter-item-slug={ch.slug}>
                <a href={`/book/${slug}/${ch.slug}`} class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-muted/50 transition-colors group border border-transparent hover:border-border/50 bg-background/50 text-sm">
                  <span class="shrink-0 w-7 h-7 rounded-full bg-muted flex items-center justify-center text-xs font-mono text-muted-foreground group-hover:bg-primary group-hover:text-primary-foreground transition-colors shadow-xs js-ch-badge">{ch.index}</span>
                  <span class="font-medium text-foreground group-hover:text-primary transition-colors grow line-clamp-1">{ch.title}</span>
                  <span class="js-ch-read-icon hidden shrink-0 text-primary"><Check class="w-4 h-4" /></span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </div>
      
      {hasAuthorCard && (
        <div class="mt-auto pt-4 border-t border-border/50 shrink-0"><AuthorCard /></div>
      )}
    </>
  )}
</div>
