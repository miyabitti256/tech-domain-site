---
import { ArrowRight, Menu, Moon, Rss, Search, Sun } from "@lucide/astro";
import Github from "simple-icons-astro/Github";
import { Button } from "@/components/starwind/button";
import {
	Sheet,
	SheetContent,
	SheetHeader,
	SheetTitle,
	SheetTrigger,
} from "@/components/starwind/sheet";

const navLinks = [
	{ href: "/article", label: "Articles" },
	{ href: "/book", label: "Books" },
	{ href: "/#about", label: "About" },
	{ href: "/search", label: "Search" },
];
---

<header class="flex items-center justify-between px-6 py-4 border-b border-border bg-background/80 backdrop-blur-md sticky top-0 z-50" transition:animate="none">

  <div class="flex items-center gap-8">
    <a href="/" class="font-mono font-bold flex items-center gap-2 group text-xl tracking-tighter">
      🫑tech.miyabitti
    </a>
    
    <nav class="hidden md:flex items-center gap-8 text-xs">
      {navLinks.map(link => (
        <a href={link.href} class="font-mono text-muted-foreground hover:text-foreground transition-colors tracking-widest uppercase">
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="flex items-center gap-2 md:gap-4">
    {/* Search Trigger */}
    <div class="relative flex items-center justify-end w-9 h-9">
      <Button variant="ghost" size="icon-sm" class="rounded-full shrink-0 w-9 h-9 text-muted-foreground hover:bg-secondary/80 transition-colors" id="search-open-btn" title="Search" aria-label="Search">
        <Search size={18} />
      </Button>
    </div>

    <div class="hidden md:flex items-center gap-2 border-l border-border pl-4">
      <a href="/rss.xml" class="p-2 text-muted-foreground hover:text-foreground transition-colors" title="RSS Feed">
        <Rss size={18} />
      </a>
      <a href="https://github.com/miyabitti256" target="_blank" rel="noopener noreferrer" class="p-2 text-muted-foreground hover:text-foreground transition-colors" title="GitHub">
        <Github size={18} />
      </a>
    </div>

    <Button
      id="theme-toggle"
      variant="outline"
      size="icon-sm"
      class="bg-background text-foreground rounded-full hidden md:flex border-none shadow-none"
      title="Toggle Theme"
    >
      <Sun id="sun-icon" class="hidden dark:block" size={18} />
      <Moon id="moon-icon" class="block dark:hidden" size={18} />
    </Button>

    {/* Starwind UI Sheet for Mobile Menu */}
    <Sheet>
      <SheetTrigger asChild>
        <Button variant="ghost" size="icon-sm" class="md:hidden text-muted-foreground rounded-full" aria-label="Open menu">
          <Menu size={24} />
        </Button>
      </SheetTrigger>
      <!-- Overhauled Sheet Design -->
      <SheetContent side="right" class="w-full sm:w-[420px] border-l border-border bg-background/95 backdrop-blur-xl p-6 flex flex-col shadow-2xl">
        <SheetHeader class="text-left mt-2 mb-6">
          <SheetTitle class="font-bold text-xl text-foreground">
            Menu
          </SheetTitle>
        </SheetHeader>
        
        <nav class="flex flex-col">
          {navLinks.map((link) => (
            <a href={link.href} class="flex items-center justify-between py-4 border-b border-border/50 text-muted-foreground hover:text-foreground hover:bg-muted/40 transition-colors px-4 -mx-4 rounded-xl">
              <span class="text-lg font-medium">
                {link.label}
              </span>
              <ArrowRight size={18} class="text-muted-foreground/50" />
            </a>
          ))}
        </nav>
        
        <div class="mt-auto pt-8 flex flex-col gap-3">
          <Button id="mobile-theme-toggle" variant="outline" class="w-full flex items-center justify-center gap-2 h-12 rounded-xl text-muted-foreground hover:text-foreground">
            <Sun class="hidden dark:block" size={18} />
            <Moon class="block dark:hidden" size={18} />
            <span class="font-medium text-sm">Toggle Theme</span>
          </Button>

          <div class="flex gap-3">
            <a href="/rss.xml" class="flex-1 flex items-center justify-center gap-2 h-12 rounded-xl border border-border bg-background hover:bg-muted/50 text-muted-foreground hover:text-foreground transition-colors" title="RSS Feed">
              <Rss size={18} />
              <span class="text-sm font-medium">RSS</span>
            </a>
            <a href="https://github.com/miyabitti256" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center gap-2 h-12 rounded-xl border border-border bg-background hover:bg-muted/50 text-muted-foreground hover:text-foreground transition-colors" title="GitHub">
              <Github size={18} />
              <span class="text-sm font-medium">GitHub</span>
            </a>
          </div>
        </div>
      </SheetContent>
    </Sheet>
  </div>
</header>

<dialog id="search-dialog" class="m-0 p-0 block bg-transparent border border-transparent rounded-full overflow-hidden w-9 h-9 transition-all duration-300 ease-out origin-right text-foreground">
  <div class="relative w-full h-full">
    <Button variant="ghost" size="icon-sm" class="absolute left-0 top-0 rounded-full shrink-0 w-9 h-9 text-muted-foreground hover:bg-secondary/80 transition-colors pointer-events-none" id="search-close-btn" aria-hidden="true">
      <Search size={18} />
    </Button>
    <input 
      type="text" 
      id="search-input" 
      class="w-full h-full bg-transparent border-none outline-none text-sm pl-10 pr-4 opacity-0 pointer-events-none transition-opacity duration-300 text-foreground placeholder:text-muted-foreground/70" 
      placeholder="Search articles..." 
    />
  </div>
</dialog>

<style>
  #search-dialog {
    max-width: none;
    max-height: none;
  }
  #search-dialog::backdrop {
    background-color: rgba(9, 9, 11, 0.6);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 0.4s ease-out;
  }
  #search-dialog[open]::backdrop {
    opacity: 1;
  }
  #search-dialog.is-closing::backdrop {
    opacity: 0;
  }
</style>

<script>
  const setupHeader = () => {
    // --- Theme Toggle Logic (Curtain Effect) ---
    const toggleBtns = document.querySelectorAll('#theme-toggle, #mobile-theme-toggle');

    if (toggleBtns.length > 0 && !toggleBtns[0].hasAttribute('data-theme-listener')) {
      toggleBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
          const isDark = document.documentElement.classList.contains('dark');
          const curtain = document.getElementById('theme-curtain');
          
          const toggleTheme = () => {
            if (isDark) {
              document.documentElement.classList.remove('dark');
              localStorage.setItem('theme', 'light');
            } else {
              document.documentElement.classList.add('dark');
              localStorage.setItem('theme', 'dark');
            }
          };

          if (curtain) {
            const oldBg = isDark ? '#09090b' : '#ffffff'; 
            curtain.style.setProperty('--curtain-color', oldBg);
            curtain.classList.remove('is-opening', 'is-closing');
            
            // Use Popover API to elevate to Top Layer without violating semantics
            if (typeof curtain.showPopover === 'function' && !curtain.matches(':popover-open')) {
              curtain.showPopover();
            }

            void curtain.offsetWidth;
            curtain.classList.add('is-closing');

            await new Promise(r => setTimeout(r, 700));

            // 3. VTは使わず、単にクラス制御でテーマ切替とトランジション無効化を瞬時に適用する
            document.documentElement.classList.add('is-theme-toggling');
            
            toggleTheme();
            curtain.classList.remove('is-closing');
            curtain.classList.add('is-opening');

            // 強制的にリフロー（再描画の計算）を発生させ、トランジション無しでのテーマ色変更を確定させる
            void document.documentElement.offsetHeight;

            // 確定後にトランジション無効化クラスを外す（以降のホバー等は正常にアニメーションする）
            document.documentElement.classList.remove('is-theme-toggling');

            setTimeout(() => {
               curtain.classList.remove('is-opening');
               if (typeof curtain.hidePopover === 'function' && curtain.matches(':popover-open')) {
                 curtain.hidePopover();
               }
            }, 1000);
          } else {
            toggleTheme();
          }
        });
        btn.setAttribute('data-theme-listener', 'true');
      });
    }

    // --- Search Interaction Logic ---
    const openBtn = document.getElementById('search-open-btn');
    const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;

    if (openBtn && dialog && searchInput && !openBtn.hasAttribute('data-search-init')) {
      openBtn.setAttribute('data-search-init', 'true');
      let isSearchActive = false;

      const openSearch = () => {
        isSearchActive = true;
        const rect = openBtn.getBoundingClientRect();
        
        // Hide the original trigger button so it doesn't show through the collapsing animation
        openBtn.style.opacity = '0';
        openBtn.style.pointerEvents = 'none';

        // Match exact starting position of trigger icon
        dialog.style.position = 'fixed';
        dialog.style.top = `${rect.top}px`;
        dialog.style.right = `${document.documentElement.clientWidth - rect.right}px`;
        dialog.style.bottom = 'auto';
        dialog.style.left = 'auto';

        dialog.classList.remove('is-closing');
        dialog.showModal();

        requestAnimationFrame(() => {
          // Expand animation
          dialog.classList.remove('w-9', 'bg-transparent', 'border-transparent', 'duration-300', 'ease-out');
          dialog.classList.add('w-[200px]', 'md:w-[280px]', 'bg-background', 'border-border', 'shadow-md', 'duration-500', 'ease-[cubic-bezier(0.34,1.56,0.64,1)]');
          
          searchInput.classList.remove('opacity-0', 'pointer-events-none');
          searchInput.classList.add('opacity-100', 'pointer-events-auto');
          
          setTimeout(() => {
            searchInput.focus();
          }, 300);
        });
      };

      const closeSearch = () => {
        if (!isSearchActive) return;
        isSearchActive = false;
        dialog.classList.add('is-closing');
        
        // Collapse animation
        dialog.classList.add('w-9', 'bg-transparent', 'border-transparent', 'duration-300', 'ease-out');
        dialog.classList.remove('w-[200px]', 'md:w-[280px]', 'bg-background', 'border-border', 'shadow-md', 'duration-500', 'ease-[cubic-bezier(0.34,1.56,0.64,1)]');
        
        searchInput.classList.add('opacity-0', 'pointer-events-none');
        searchInput.classList.remove('opacity-100', 'pointer-events-auto');
        
        setTimeout(() => {
          dialog.close();
          searchInput.value = '';
          searchInput.blur();
          
          // Show the original trigger button again after animation fully completes
          openBtn.style.opacity = '1';
          openBtn.style.pointerEvents = 'auto';
        }, 400); // Wait for CSS transitions
      };

      openBtn.addEventListener('click', (e) => {
        e.preventDefault();
        openSearch();
      });

      // Handle Enter key: navigate to search page
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          const query = searchInput.value.trim();
          if (query) {
            closeSearch();
            const url = `/search?q=${encodeURIComponent(query)}`;
            window.location.href = url;
          }
        }
      });

      // Handle click on backdrop
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          closeSearch();
        }
      });

      // Handle ESC key accurately by intercepting native cancel
      dialog.addEventListener('cancel', (e) => {
        e.preventDefault();
        closeSearch();
      });
    }
  };

  document.addEventListener('astro:page-load', setupHeader);
</script>

