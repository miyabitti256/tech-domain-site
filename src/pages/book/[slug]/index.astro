---
import { getCollection } from "astro:content";
import { ChevronLeft } from "@lucide/astro";
import DesktopBookView from "@/components/book/DesktopBookView.astro";
import MobileBookView from "@/components/book/MobileBookView.astro";
import type { BookMeta } from "@/contents/book/types";
import Layout from "@/layouts/Layout.astro";

export async function getStaticPaths() {
	const metas = import.meta.glob<{ default: BookMeta }>(
		"/src/contents/book/*/meta.ts",
		{ eager: true },
	);

	const allChapters = await getCollection("book");

	return Object.entries(metas).map(([filepath, mod]) => {
		const slug = filepath.split("/").at(-2) ?? "";
		const meta = mod.default;

		const chapterTitles = new Map<string, string>();
		for (const ch of meta.chapters) {
			const entryId = `${slug}/${ch}`;
			const found = allChapters.find((e) => e.id === entryId);
			if (found) {
				chapterTitles.set(ch, found.data.title);
			}
		}

		return {
			params: { slug },
			props: { meta, slug, chapterTitles },
		};
	});
}

const { meta, slug, chapterTitles } = Astro.props;

const publishedAt = new Date(meta.publishedAt);
const updatedAt = meta.updatedAt ? new Date(meta.updatedAt) : null;

const formattedDate = publishedAt.toLocaleDateString("ja-JP", {
	year: "numeric",
	month: "long",
	day: "numeric",
});

const formattedUpdateDate = updatedAt
	? updatedAt.toLocaleDateString("ja-JP", {
			year: "numeric",
			month: "long",
			day: "numeric",
		})
	: null;

// 章データリスト作成
const chapterList = meta.chapters.map((chSlug, idx) => ({
	slug: chSlug,
	title: chapterTitles.get(chSlug) || chSlug,
	index: idx + 1,
}));

// 見開き (Spread) 分割計算ロジック
type PageContent = {
	chapters: typeof chapterList;
	hasAuthorCard: boolean;
};

type Spread = {
	spreadIndex: number;
	leftPage: PageContent | { isBookInfo: true };
	rightPage: PageContent;
};

function calculateSpreads(chapters: typeof chapterList): Spread[] {
	const CHAPTER_CAPACITY = 8;
	const AUTHOR_CARD_COST = 2;

	const spreads: Spread[] = [];
	let remainingChapters = [...chapters];

	// Spread 0
	const rightPage0Chapters: typeof chapterList = [];
	let rightPage0Slots = 0;

	while (
		remainingChapters.length > 0 &&
		rightPage0Slots + 1 <= CHAPTER_CAPACITY
	) {
		if (
			remainingChapters.length <=
			CHAPTER_CAPACITY - rightPage0Slots - AUTHOR_CARD_COST
		) {
			rightPage0Chapters.push(...remainingChapters);
			remainingChapters = [];
			rightPage0Slots += rightPage0Chapters.length;
			break;
		}
		const nextCh = remainingChapters.shift();
		if (nextCh) {
			rightPage0Chapters.push(nextCh);
			rightPage0Slots += 1;
		}
	}

	const rightPage0HasAuthor =
		remainingChapters.length === 0 &&
		rightPage0Slots + AUTHOR_CARD_COST <= CHAPTER_CAPACITY;

	spreads.push({
		spreadIndex: 0,
		leftPage: { isBookInfo: true },
		rightPage: {
			chapters: rightPage0Chapters,
			hasAuthorCard: rightPage0HasAuthor,
		},
	});

	let authorCardPlaced = rightPage0HasAuthor;

	// 追加のSpread構築
	let currentSpreadIndex = 1;
	while (remainingChapters.length > 0 || !authorCardPlaced) {
		// Left Page
		const leftChapters: typeof chapterList = [];
		let leftSlots = 0;

		while (remainingChapters.length > 0 && leftSlots + 1 <= CHAPTER_CAPACITY) {
			if (
				remainingChapters.length <=
				CHAPTER_CAPACITY - leftSlots - AUTHOR_CARD_COST
			) {
				leftChapters.push(...remainingChapters);
				remainingChapters = [];
				leftSlots += leftChapters.length;
				break;
			}
			const nextCh = remainingChapters.shift();
			if (nextCh) {
				leftChapters.push(nextCh);
				leftSlots += 1;
			}
		}

		let leftHasAuthor = false;
		if (
			remainingChapters.length === 0 &&
			!authorCardPlaced &&
			leftSlots + AUTHOR_CARD_COST <= CHAPTER_CAPACITY
		) {
			leftHasAuthor = true;
			authorCardPlaced = true;
		}

		// Right Page
		const rightChapters: typeof chapterList = [];
		let rightSlots = 0;
		let rightHasAuthor = false;

		if (remainingChapters.length > 0 || !authorCardPlaced) {
			while (
				remainingChapters.length > 0 &&
				rightSlots + 1 <= CHAPTER_CAPACITY
			) {
				if (
					remainingChapters.length <=
					CHAPTER_CAPACITY - rightSlots - AUTHOR_CARD_COST
				) {
					rightChapters.push(...remainingChapters);
					remainingChapters = [];
					rightSlots += rightChapters.length;
					break;
				}
				const nextCh = remainingChapters.shift();
				if (nextCh) {
					rightChapters.push(nextCh);
					rightSlots += 1;
				}
			}

			if (
				remainingChapters.length === 0 &&
				!authorCardPlaced &&
				rightSlots + AUTHOR_CARD_COST <= CHAPTER_CAPACITY
			) {
				rightHasAuthor = true;
				authorCardPlaced = true;
			}
		}

		spreads.push({
			spreadIndex: currentSpreadIndex,
			leftPage: {
				chapters: leftChapters,
				hasAuthorCard: leftHasAuthor,
			},
			rightPage: {
				chapters: rightChapters,
				hasAuthorCard: rightHasAuthor,
			},
		});

		currentSpreadIndex++;
	}

	return spreads;
}

const spreads = calculateSpreads(chapterList);
---

<Layout 
  title={`${meta.title} | miyabittiのテックブログ`} 
  description={meta.description}
  ogImage={`/ogp/book/${slug}.webp`}
  ogType="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Book",
      "name": meta.title,
      "description": meta.description,
      "datePublished": publishedAt.toISOString(),
      "dateModified": updatedAt ? updatedAt.toISOString() : publishedAt.toISOString(),
      "author": {
        "@type": "Person",
        "name": "miyabitti",
        "url": "https://github.com/miyabitti256"
      },
      "publisher": {
        "@type": "Organization",
        "name": "tech.miyabitti",
        "logo": {
          "@type": "ImageObject",
          "url": new URL("/avatar.webp", Astro.site).href
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": new URL(`/book/${slug}/`, Astro.site).href
      }
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL("/", Astro.site).href },
        { "@type": "ListItem", "position": 2, "name": "Books", "item": new URL("/book/", Astro.site).href },
        { "@type": "ListItem", "position": 3, "name": meta.title }
      ]
    })} />
  </Fragment>

  <main class="py-8 md:px-4 bg-muted/10 relative overflow-x-hidden" data-book-slug={slug} data-total-chapters={chapterList.length}>
    <div class="w-full max-w-5xl mx-auto mb-4 px-6 md:px-2 z-10 mt-8 md:mt-2">
      <a href="/book" class="inline-flex items-center text-sm font-medium text-muted-foreground hover:text-foreground transition-colors group">
        <ChevronLeft class="w-4 h-4 mr-1 transition-transform group-hover:-translate-x-1" />
        本一覧に戻る
      </a>
    </div>

    {/* PC表示用コンポーネント (完璧な見開き3Dフリップ) */}
    <DesktopBookView 
      meta={meta}
      slug={slug}
      chapterList={chapterList}
      spreads={spreads}
      formattedDate={formattedDate}
      formattedUpdateDate={formattedUpdateDate}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
    />

    {/* モバイル表示用コンポーネント (破綻のない単一ページナビ & スクロール同期めくり) */}
    <MobileBookView 
      meta={meta}
      slug={slug}
      chapterList={chapterList}
      spreads={spreads}
      formattedDate={formattedDate}
      formattedUpdateDate={formattedUpdateDate}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
    />
  </main>
</Layout>
